# === Supabase (required) ===
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# === Cloudinary (required for image upload) ===
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# === JWT (required for auth) ===
JWT_SECRET=your-random-jwt-secret

# === CORS Origins ===
# FRONTEND_URL is also used to build the Track Order link inside the customer
# confirmation email (https://<FRONTEND_URL>/track-order?order_id=<order no>).
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# === Admin login credentials — server-side ONLY (server/.env.local) ===
# The admin panel's master login comes from ADMIN_USERNAME / ADMIN_PASSWORD in
# server/.env.local (gitignored, never committed). They are NOT read from
# .env or this example file. No hardcoded fallbacks exist anywhere in the
# codebase — scripts fail loudly when the vars are missing.
# ADMIN_USERNAME=
# ADMIN_PASSWORD=

# === Brevo (transactional email: order confirmations + admin notifications) ===
BREVO_API_KEY=your-brevo-api-key
# Template IDs must match the live Brevo templates:
#   2 = Hallmark - Customer Order Confirmation
#   3 = Hallmark - Admin New Order Notification
BREVO_CUSTOMER_TEMPLATE_ID=
BREVO_ADMIN_TEMPLATE_ID=
ADMIN_EMAIL=
