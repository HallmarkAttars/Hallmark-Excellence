# === Supabase (required) ===
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# === Cloudinary (required for image upload) ===
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# === JWT (required for auth) ===
JWT_SECRET=your-random-jwt-secret

# === CORS Origins ===
# FRONTEND_URL is also used to build the Track Order link inside the customer
# confirmation email (https://<FRONTEND_URL>/track-order?order_id=<order no>).
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# === Admin login credentials — server-side ONLY (server/.env.local) ===
# The admin panel's master login comes from ADMIN_USERNAME / ADMIN_PASSWORD in
# server/.env.local (gitignored, never committed). They are NOT read from
# .env or this example file. No hardcoded fallbacks exist anywhere in the
# codebase — scripts fail loudly when the vars are missing.
# ADMIN_USERNAME=
# ADMIN_PASSWORD=

# === Brevo (transactional email: order confirmations + admin notifications) ===
BREVO_API_KEY=your-brevo-api-key
# Template IDs must match the live Brevo templates:
#   2 = Hallmark - Customer Order Confirmation
#   3 = Hallmark - Admin New Order Notification
BREVO_CUSTOMER_TEMPLATE_ID=
BREVO_ADMIN_TEMPLATE_ID=
ADMIN_EMAIL=

# === WhatsApp webhook (Meta verification + message forwarding) ===
# Verify token Meta sends during the webhook handshake. Falls back to
# "arees_perfumes_2026" when unset.
WHATSAPP_VERIFY_TOKEN=arees_perfumes_2026
# Inbound messages are forwarded here so the storefront bot keeps replying.
WA_WEBHOOK_FORWARD_URL=https://www.areesperfumes.in/api/wa-webhook

# === WhatsApp Cloud API (order-status notifications) ===
# Permanent System User token. Never commit the real value.
WHATSAPP_TOKEN=your-whatsapp-access-token
# Numeric Phone number ID from Meta -> WhatsApp -> API Setup (NOT the phone
# number itself, e.g. 123456789012345).
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v23.0
# Optional approved template for status updates sent outside the 24-hour
# customer-service window. Leave blank to send free-form text only.
WHATSAPP_STATUS_TEMPLATE_NAME=
WHATSAPP_STATUS_TEMPLATE_LANG=en
# Public storefront base used for the tracking link in the message.
STOREFRONT_URL=https://www.areesperfumes.in
