{
  "functions": {
    "api/sitemap.js": {
      "maxDuration": 15
    },
    "api/meta.js": {
      "maxDuration": 15
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(webp|png|jpg|jpeg|svg|ico|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/robots.txt", "destination": "/api/robots" },
    { "source": "/hikma-exports", "destination": "/api/meta?type=page&slug=hikma-exports" },
    { "source": "/about", "destination": "/api/meta?type=page&slug=about" },
    { "source": "/wholesale", "destination": "/api/meta?type=page&slug=wholesale" },
    { "source": "/wholesale-attars", "destination": "/api/meta?type=page&slug=wholesale" },
    { "source": "/contact", "destination": "/api/meta?type=page&slug=contact" },
    { "source": "/shop", "destination": "/api/meta?type=page&slug=shop" },
    { "source": "/categories", "destination": "/api/meta?type=page&slug=categories" },
    { "source": "/brands", "destination": "/api/meta?type=page&slug=brands" },
    { "source": "/retail", "destination": "/api/meta?type=page&slug=retail" },
    { "source": "/retail-attars", "destination": "/api/meta?type=page&slug=retail" },
    { "source": "/attar-perfume-shop-south-india", "destination": "/api/meta?type=page&slug=attar-perfume-shop-south-india" },
    { "source": "/south-india", "destination": "/api/meta?type=page&slug=attar-perfume-shop-south-india" },
    { "source": "/product/:id", "destination": "/api/meta?type=product&id=:id" },
    { "source": "/categories/:slug", "destination": "/api/meta?type=category&slug=:slug" },
    { "source": "/brand/:slug", "destination": "/api/meta?type=brand&slug=:slug" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
