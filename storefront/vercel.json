{
  "functions": {
    "api/sitemap.js": {
      "maxDuration": 15
    },
    "api/meta.js": {
      "maxDuration": 15
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(webp|png|jpg|jpeg|svg|ico|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/robots.txt", "destination": "/api/robots" },
    { "source": "/product/:id", "destination": "/api/meta?type=product&id=:id" },
    { "source": "/categories/:slug", "destination": "/api/meta?type=category&slug=:slug" },
    { "source": "/brand/:slug", "destination": "/api/meta?type=brand&slug=:slug" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
