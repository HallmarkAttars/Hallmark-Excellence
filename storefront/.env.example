# =============================================================
# Hallmark Excellence – Storefront Environment Variables
# =============================================================
#
# This file is tracked in git as a template. Copy its contents to:
#
#   .env.development   → for local development
#   .env.production    → for Vercel / production builds
#
# ⚠️  Never commit .env (secrets) or .env.*.local (local overrides).
#
# =============================================================

# API base URL — points to the Express backend
# Development: http://localhost:5000
# Production:  https://hallmark-excellence.onrender.com
VITE_API_BASE_URL=

# =============================================================
# WhatsApp Cloud API — server-side only (Vercel functions)
# Set these in Vercel -> Settings -> Environment Variables.
# Never prefix them with VITE_ (they must not reach the browser).
# =============================================================
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_QR_URL=
WHATSAPP_UPI_ID=qr.hikmaex@sib

# Vercel KV — required for the daily order-status cron
KV_REST_API_URL=
KV_REST_API_TOKEN=

